{
  "app": {
    "language": "ro",
    "max_history": 5,
    "default_output_dir": "./output",
    "auto_open_ppt": true
  },
  "verses": {
    "font_family": "Calibri",
    "font_min_size": 32,
    "font_max_size": 60,
    "font_size_step": 4,
    "color": "#FFFFFF",
    "bg_color": "#000000",
    "margin_inches": 0.5,
    "safety_margin_percent": {
      "height": 5,
      "width": 5
    }
  },
  "amin_slide": {
    "font_size": 22,
    "font_family": "Calibri",
    "is_bold": false,
    "is_italic": false,
    "color": "#FFFFFF",
    "position": {
      "right_cm": 2,
      "bottom_cm": 2
    },
    "align": "right"
  },
  "refrain": {
    "start_marker": "/:",
    "end_marker": ":/"
  }
}